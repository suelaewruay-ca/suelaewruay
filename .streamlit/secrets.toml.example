# Copy to secrets.toml. Do not commit real credentials.
GOOGLE_API_KEY = ""
# Use a vision / structured-output model available to your Google account.
GEMINI_MODEL = ""
# Required for initial setup on a hosted server. Use different passwords, 8+ characters.
# On this computer you can run setup_admin.cmd instead.
ADMIN_PASSWORD = ""
APP_PASSWORD = ""
# These values initialize the database once. Later changes are made in the admin page.
# Optional: absolute path on persistent storage (local disk is not durable on Community Cloud).
# ZANI_SETTINGS_DB = "/persistent/zani/settings.db"
# Formula sources: configure the Sheet URL, tab and JSON in the admin formula panel.
# Share the formula Sheet with the service account as Viewer.
# Login audit: configure its separate Sheet and JSON in the admin history panel.
# Share the audit Sheet with its service account as Editor.

